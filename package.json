{
  "name": "orbis-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx scripts/build.ts && tsx scripts/verify.ts",
    "check": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "dev": "npm run build && wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.127.1"
  }
}
